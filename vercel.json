{
  "version": 2,
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "memory": 1024,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
